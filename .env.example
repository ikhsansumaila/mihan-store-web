# Salin ke .env lalu isi nilainya:  cp .env.example .env && chmod 600 .env
# File .env berisi rahasia dan TIDAK boleh di-commit (sudah ada di .gitignore).

# Database (MySQL di container mysql_db, jaringan Docker mysql-net)
DB_HOST=mysql_db
DB_PORT=3306
DB_NAME=mihanstore
DB_USER=mihanstore_app
DB_PASSWORD=

# Masa berlaku sesi login (jam). Default 168 = 7 hari.
SESSION_TTL_HOURS=168

# Origin yang boleh memanggil API (pisahkan dengan koma)
CORS_ALLOWED_ORIGINS=https://store.mihan.web.id,https://mihankids.my.id

# Cloudflare Turnstile (dashboard Cloudflare > Turnstile). Site key dipakai saat build frontend.
# Tanpa TURNSTILE_SECRET_KEY, login & registrasi ditolak (fail-closed).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# HANYA untuk pengembangan lokal: matikan Turnstile bila secret kosong. Jangan diisi di produksi.
# ALLOW_NO_TURNSTILE=true
