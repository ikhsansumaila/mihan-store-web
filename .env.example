# Salin ke .env lalu isi nilainya:  cp .env.example .env && chmod 600 .env
# File .env berisi rahasia dan TIDAK boleh di-commit (sudah ada di .gitignore).

# Database (MySQL di container mysql_db, jaringan Docker mysql-net)
DB_HOST=mysql_db
DB_PORT=3306
DB_NAME=mihanstore
DB_USER=mihanstore_app
DB_PASSWORD=

# Masa berlaku sesi login (jam). Default 168 = 7 hari.
SESSION_TTL_HOURS=168

# Origin yang boleh memanggil API (pisahkan dengan koma)
CORS_ALLOWED_ORIGINS=https://store.mihan.web.id,https://mihankids.my.id

# Cloudflare Turnstile (dashboard Cloudflare > Turnstile). Site key dipakai saat build frontend.
# Tanpa TURNSTILE_SECRET_KEY, login & registrasi ditolak (fail-closed).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# HANYA untuk pengembangan lokal: matikan Turnstile bila secret kosong. Jangan diisi di produksi.
# ALLOW_NO_TURNSTILE=true

# --- Admin (Cloudflare Access) ---
# Email admin (pisahkan dengan koma, tidak peka huruf besar/kecil). Akun admin dibuat/
# dinaikkan otomatis saat email ini masuk lewat Cloudflare Access atau login Google.
ADMIN_EMAILS=
# Team domain Zero Trust, mis. namateam.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
# Application Audience (AUD) tag aplikasi Access "Mihan Store Admin".
# Kosong = semua /api/admin/* ditolak 503 (fail-closed).
CF_ACCESS_AUD_STORE=

# --- Login Google pelanggan ---
# Client ID OAuth (Web application) dari Google Cloud. Bukan rahasia.
# Kosong = tombol Google disembunyikan dan /api/auth/google* menjawab 503.
GOOGLE_CLIENT_ID=
# Sama dengan GOOGLE_CLIENT_ID; ditanam ke frontend saat build.
REACT_APP_GOOGLE_CLIENT_ID=
# Rahasia acak (>= 32 karakter) untuk menandatangani profileToken. Buat dengan:
#   openssl rand -base64 48
AUTH_HMAC_SECRET=

# --- Pesanan ---
# URL webhook Discord untuk notifikasi pesanan (RAHASIA, jangan dibagikan/di-commit).
# Discord: Pengaturan channel > Integrasi > Webhook > Webhook Baru > Salin URL Webhook.
# Kosong = notifikasi dinonaktifkan (backend tetap jalan, ada peringatan di log).
# Hanya URL https://discord.com/api/webhooks/... yang diterima.
DISCORD_ORDER_WEBHOOK_URL=
# URL publik toko untuk tautan detail pesanan di notifikasi.
PUBLIC_BASE_URL=https://store.mihan.web.id

# --- Notifikasi push admin (Web Push / VAPID) ---
# Kosong = fitur nonaktif (backend tetap jalan). Buat pasangan kunci SEKALI lalu simpan di .env
# (kunci privat RAHASIA; mengganti kunci membuat semua perangkat admin harus mengaktifkan ulang notifikasi).
# Format base64url P-256 (mis. dari webpush.GenerateVAPIDKeys() / `npx web-push generate-vapid-keys`).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto:email-toko atau https://domain-toko (default: PUBLIC_BASE_URL).
VAPID_SUBJECT=

# KHUSUS CONTAINER UJI (jangan pernah diisi di produksi; diabaikan bila DB_NAME bukan *_test):
# TEST_ONLY_CF_ACCESS_JWKS_URL=
# TEST_ONLY_GOOGLE_JWKS_URL=

# --- Foto produk ---
# Lapisan penyimpanan foto (saat ini hanya "local" = folder ./uploads di VPS).
IMAGE_STORE=local
# Batas total ukuran folder unggahan (MB). Lewat batas -> unggahan baru ditolak (507).
MAX_UPLOADS_MB=
# Bukti transfer pelanggan disimpan PRIVAT di ./private-uploads (di-mount hanya ke backend sebagai
# /data/private-uploads, lihat docker-compose.yml). Tidak ada variabel yang perlu diisi.2048
